# Copy to .env and adjust. docker compose reads .env from the repo root.

# Host ports
DB_PORT=5447
API_PORT=4407
WEB_PORT=5187

# Signs login tokens. Use a long random string (32+ characters) outside
# local development.
JWT_SECRET=local-development-secret-change-me-0123456789

# How long a login lasts, in hours.
TOKEN_TTL_HOURS=168

# Log filter (see tracing-subscriber's EnvFilter).
RUST_LOG=shared_expenses_api=info,tower_http=info

